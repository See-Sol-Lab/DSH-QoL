{
  "name": "@see-sol-lab/dsh-qol",
  "description": "DSH 生活质量包：给 DeepSeek Harness 官方桌面端补上 DeepSeekGUI 的体验细节——四项上报默认关并可在设置里开关，助手可用的 Git 与 PR 工具。",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./git-local": "./lib/host/git-local.js",
    "./pull-request-gh": "./lib/host/pull-request-gh.js",
    "./coding-tools": "./lib/host/coding-tools.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}
