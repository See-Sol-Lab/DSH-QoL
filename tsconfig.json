{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "experimentalDecorators": false,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/dsh-git": ["./src/host/git/index.ts"],
      "@deepseek-ai/dsh-git/types": ["./src/host/git/types.ts"],
      "@deepseek-ai/dsh-pull-request": ["./src/host/pull-request/index.ts"],
      "@deepseek-ai/dsh-pull-request/types": ["./src/host/pull-request/types.ts"]
    }
  },
  "include": ["src"]
}
